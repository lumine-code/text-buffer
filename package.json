{
  "name": "@lumine-code/text-buffer",
  "author": "lumine-code",
  "version": "16.0.0",
  "description": "Provides Lumine's mutable text buffer and marker model as a headless module.",
  "main": "./src/text-buffer",
  "scripts": {
    "prepack": "npm run clean",
    "clean": "node -e \"const fs=require('fs'); for (const path of ['lib', 'api.json']) fs.rmSync(path, {recursive:true, force:true})\"",
    "test": "node script/test",
    "ci": "npm run test && npm run bench",
    "bench": "node benchmarks/index"
  },
  "repository": "https://github.com/lumine-code/text-buffer",
  "bugs": "https://github.com/lumine-code/text-buffer/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "dedent": "^1.7.2",
    "electron": "^43.1.0",
    "jasmine": "^6.3.0",
    "random-seed": "^0.3.0",
    "regression": "^2.0.1",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "@lumine-code/pathwatcher": "https://github.com/lumine-code/node-pathwatcher.git#ffe5b7b29242c9031e11a0df85f7c0d79f6cc990",
    "@lumine-code/superstring": "https://github.com/lumine-code/superstring.git#d68207886ca8819e00e4df42f4d99dd8c5bc568b",
    "diff": "^9.0.0",
    "event-kit": "^2.5.3",
    "fs-admin": "^0.20.0",
    "@lumine-code/fs-plus": "https://github.com/lumine-code/fs-plus.git#742e3e166f56261189ff245a63967b8f1970fadd",
    "grim": "^2.0.3",
    "@lumine-code/underscore-plus": "https://github.com/lumine-code/underscore-plus.git#2b75d264c2ca01d27ee69d7cd05610a097011274",
    "winattr": "^3.0.0"
  },
  "standard": {
    "env": {
      "atomtest": true,
      "browser": true,
      "jasmine": true,
      "node": true
    },
    "globals": [
      "atom",
      "snapshotResult"
    ]
  }
}
